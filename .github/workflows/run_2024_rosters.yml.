
name: Collect 2024 MLB Rosters

on:
  workflow_dispatch:

jobs:
  collect:
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Collect MLB rosters
        run: |
          python build_2024_rosters.py --start 2024-07-01 --end 2024-07-01

      - name: Save roster dataset
        uses: actions/upload-artifact@v4
        with:
          name: mlb-rosters-2024-test
          path: mlb-connections-2024.json
